<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · RendApps</title>
  <meta name="description" content="RendApps: desarrollamos aplicaciones móviles, software a medida, integraciones y soluciones web que optimizan procesos y generan valor real.">
  <%# El ?v= es obligatorio al cambiar el ícono: los navegadores cachean los
      favicons de forma muy agresiva y no respetan el no-cache del sitio.
      Sin cambiar la URL, el visitante sigue viendo el logo antiguo. %>
  <link rel="icon" href="/img/favicon.svg?v=2" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <% if (typeof fuentesApp !== 'undefined' && fuentesApp) { %>
  <!-- Tipografías de la app Gatheryx: la demo usa las mismas que el producto real -->
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <% } %>
  <link rel="stylesheet" href="/css/styles.css?v=6">
</head>
<body>
<a class="saltar" href="#contenido">Saltar al contenido</a>

<header class="cabecera" id="cabecera">
  <div class="contenedor cabecera-int">
    <a class="logo" href="/" aria-label="RendApps, inicio">
      <svg class="logo-icono" width="42" height="42" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="gradLogoAzul" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#3B82F6"/>
            <stop offset="1" stop-color="#1E3A8A"/>
          </linearGradient>
          <linearGradient id="gradLogoNaranja" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FDBA74"/>
            <stop offset="1" stop-color="#F97316"/>
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="56" height="56" rx="18" fill="url(#gradLogoAzul)"/>
        <path d="M20 42 L32 30 L44 42" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        <path class="logo-chevron" d="M25 29 L32 22 L39 29" fill="none" stroke="url(#gradLogoNaranja)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="logo-texto">Rend<em>Apps</em></span>
    </a>

    <nav class="nav" id="nav-principal" aria-label="Principal">
      <ul class="nav-lista">
        <li><a href="/" class="nav-enlace <%= pagina === 'inicio' ? 'activo' : '' %>">Inicio</a></li>
        <li><a href="/servicios" class="nav-enlace <%= pagina === 'servicios' ? 'activo' : '' %>">Servicios</a></li>
        <li><a href="/proyectos" class="nav-enlace <%= pagina === 'proyectos' ? 'activo' : '' %>">Proyectos</a></li>
        <li><a href="/planes" class="nav-enlace <%= pagina === 'planes' ? 'activo' : '' %>">Planes</a></li>
        <li><a href="/nosotros" class="nav-enlace <%= pagina === 'nosotros' ? 'activo' : '' %>">Nosotros</a></li>
        <li><a href="/soporte" class="nav-enlace <%= pagina === 'soporte' ? 'activo' : '' %>">Soporte</a></li>
    
        <li class="nav-cta-item"><a href="/contacto" class="btn btn-contorno btn-chico">Cotiza tu proyecto</a></li>
      </ul>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-principal" aria-label="Abrir menú">
      <%- include('icono', { n: 'menu', t: 24 }) %>
    </button>
  </div>
</header>

<main id="contenido">
