                  <button type="button" class="lx-mic" aria-label="Dictar comentarios"><%- ico('mic', 17) %></button>
                </div>
              </div>

              <div class="lx-titulo-bloque"><b>Fotos de evidencia</b><i></i></div>
              <div class="lx-fotos">
