          <span class="lx-halo lx-halo-2" aria-hidden="true"></span>
          <div class="lx-notch" aria-hidden="true"></div>

          <div class="lx-status">
            <span>9:41</span>
            <span class="lx-status-red">▮▮▮ ⌁ 87%</span>
          </div>

          <div class="lx-offline" hidden>
            <%- ico('nube_off', 15) %>
            <span>MODO LOCAL · SIN CONEXIÓN</span>
          </div>

          <div class="lx-scroll">

            <!-- ====== VISTA: INICIO ====== -->
            <div class="lx-vista lx-activa" data-nombre="inicio">
              <div class="lx-cabecera">
                <span class="lx-badge"><%- marca(30) %></span>
                <span class="lx-cabecera-txt">
                  <small>Hola de nuevo</small>
                  <b>Carolina Núñez</b>
                </span>
                <button type="button" class="lx-icono-btn" data-ir="config" aria-label="Configuración"><%- ico('ajustes', 20) %></button>
              </div>

              <span class="lx-mono" style="margin:18px 0 10px">Evento activo</span>

              <div class="lx-evento-marco">
                <div class="lx-evento">
                  <div class="lx-evento-fila">
                    <div class="lx-evento-nombre">Expomin 2026</div>
                    <span class="lx-envivo"><i class="lx-pulso"></i> EN VIVO</span>
                  </div>
                  <div class="lx-evento-meta">
                    <%- ico('calendario', 14) %>
                    <span class="lx-evento-fecha">22-04-2026 · Santiago, Chile</span>
                  </div>

                  <div class="lx-ministats">
                    <div class="lx-ministat"><b class="lx-n-total">0</b><span>Leads</span></div>
                    <div class="lx-ministat lx-verde"><b class="lx-n-hoy">0</b><span>Hoy</span></div>
                    <div class="lx-ministat lx-stat-pend"><b class="lx-n-pend">0</b><span>Por sincr.</span></div>
                  </div>

                  <div class="lx-barra"><i class="lx-avance"></i></div>
                  <p class="lx-barra-pie">—</p>

                  <button type="button" class="lx-btn-suave lx-cambiar-evento">
                    <%- ico('cambiar', 16) %> Cambiar evento
                  </button>
                </div>
              </div>

              <span class="lx-mono" style="margin:24px 0 11px">Operación</span>
              <div class="lx-ops">
                <button type="button" class="lx-op" data-ir="capturar">
                  <span class="lx-op-icono"><%- ico('mas', 22) %></span>
                  <b>Nuevo lead</b><span class="lx-op-sub">Capturar en terreno</span>
                </button>
                <button type="button" class="lx-op" data-ir="leads">
                  <span class="lx-op-icono"><%- ico('equipo', 21) %></span>
                  <b>Ver leads</b><span class="lx-op-sub">Lista del evento</span>
                </button>
                <button type="button" class="lx-op lx-op-buscar" data-ir="leads">
                  <span class="lx-op-icono"><%- ico('lupa', 21) %></span>
                  <b>Buscar</b><span class="lx-op-sub">Encontrar un lead</span>
                </button>
                <button type="button" class="lx-op" data-ir="mis-leads">
                  <span class="lx-op-icono"><%- ico('persona', 21) %></span>
                  <b>Mis leads</b><span class="lx-op-sub">Tu carpeta personal</span>
                </button>
              </div>

              <span class="lx-mono" style="margin:24px 0 11px">Administración</span>
              <div class="lx-filas">
                <button type="button" class="lx-fila" data-lx-toast="En la app real abre el formulario del nuevo evento comercial.">
                  <span class="lx-fila-icono"><%- ico('documento', 18) %></span>
                  <span class="lx-fila-txt"><b>Crear evento</b><span>Nuevo evento comercial</span></span>
                  <span class="lx-chevron"><%- ico('derecha', 16) %></span>
                </button>
                <button type="button" class="lx-fila" data-lx-toast="En la app real lista los eventos para modificar fecha, lugar o temática.">
                  <span class="lx-fila-icono"><%- ico('lapiz', 18) %></span>
                  <span class="lx-fila-txt"><b>Editar evento</b><span>Modificar existentes</span></span>
                  <span class="lx-chevron"><%- ico('derecha', 16) %></span>
                </button>
                <button type="button" class="lx-fila" data-lx-toast="El rol vive en el registro central: al cambiarlo aquí se aplica en todas las apps a la vez.">
                  <span class="lx-fila-icono"><%- ico('equipo', 18) %></span>
                  <span class="lx-fila-txt"><b>Gestionar usuarios</b><span>Roles y accesos</span></span>
                  <span class="lx-chevron"><%- ico('derecha', 16) %></span>
                </button>
                <button type="button" class="lx-fila" data-lx-toast="Los folletos y catálogos que se adjuntan al correo de agradecimiento.">
                  <span class="lx-fila-icono"><%- ico('carpeta', 18) %></span>
                  <span class="lx-fila-txt"><b>Documentos</b><span>Folletos y catálogos del correo</span></span>
                  <span class="lx-chevron"><%- ico('derecha', 16) %></span>
                </button>
                <button type="button" class="lx-fila" data-ir="exportar">
                  <span class="lx-fila-icono"><%- ico('descarga', 18) %></span>
                  <span class="lx-fila-txt"><b>Exportar</b><span>Descargar la base del evento</span></span>
                  <span class="lx-chevron"><%- ico('derecha', 16) %></span>
                </button>
              </div>

              <div class="lx-pie-usuario">
                <p><%- marca(16) %> Carolina Núñez · Administradora · Demo SpA</p>
                <button type="button" data-lx-toast="En la app real cierra la sesión y vuelve al login.">Cerrar sesión</button>
              </div>
            </div>

            <!-- ====== VISTA: CAPTURAR LEAD ====== -->
            <div class="lx-vista" data-nombre="capturar">
              <div class="lx-volver">
                <button type="button" class="lx-icono-btn" data-ir="inicio" aria-label="Volver"><%- ico('izquierda', 19) %></button>
                <span class="lx-volver-txt"><small>Nuevo lead</small><b class="lx-nombre-evento">Expomin 2026</b></span>
              </div>

              <!-- Ingreso general: un solo dictado para todo el lead -->
              <button type="button" class="lx-dictado lx-ingreso-general">
                <span class="lx-dictado-int">
                  <span class="lx-dictado-icono"><%- ico('mic', 22) %></span>
                  <span class="lx-dictado-txt">
                    <span class="lx-dictado-titulo">
                      <b class="lx-dictado-nombre">Ingreso general</b>
                      <span class="lx-etq-local" hidden>LOCAL</span>
                    </span>
                    <span class="lx-dictado-sub">Dilo todo de corrido y la IA lo reparte en cada campo</span>
                  </span>
                  <span class="lx-dictado-fin"><%- ico('derecha', 17) %></span>
                </span>
              </button>

              <div class="lx-separador"><i></i><span>O CAMPO A CAMPO</span><i></i></div>

              <div class="lx-campos">
                <div class="lx-campo-caja" data-campo="nombre">
                  <input class="lx-campo" placeholder="Nombre y Apellido *" autocomplete="off">
