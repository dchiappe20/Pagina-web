  embudo:     '<polygon points="21 4 3 4 10.5 12.5 10.5 19 13.5 20.5 13.5 12.5 21 4"/>',
  bandeja:    '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  credencial: '<rect x="2" y="4.5" width="20" height="15" rx="2"/><circle cx="8.5" cy="11" r="2.4"/><path d="M4.8 16.4a4 4 0 0 1 7.4 0"/><line x1="15" y1="10" x2="19" y2="10"/><line x1="15" y1="14" x2="19" y2="14"/>',
